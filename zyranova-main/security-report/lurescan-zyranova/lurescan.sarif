                  "ATT&CK:T1140",
                  "ATT&CK:T1027.013",
                  "CWE:CWE-506",
                  "NIST-SSDF:PW.7"
                ],
                "precision": "medium",
                "security-severity": "5.5"
              }
            },
            {
              "id": "LS-APP-006",
              "name": "PermissiveCorsPolicy",
              "shortDescription": {
                "text": "Permissive CORS policy"
              },
              "fullDescription": {
                "text": "CORS is enabled for any origin, letting any website call the API from a victim's browser."
              },
              "help": {
                "text": "Allow only known origins, especially when cookies or tokens are used.\n\nFramework alignment:\n- OWASP-Web A05 Security Misconfiguration\n- CSA-CCM AIS-04 Secure Application Design and Development\n- CWE CWE-942 Permissive Cross-domain Policy with Untrusted Domains\n- NIST-SSDF PW.9 Configure Software to Have Secure Settings by Default"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "app-security",
                  "OWASP-Web:A05",
                  "CSA-CCM:AIS-04",
                  "CWE:CWE-942",
                  "NIST-SSDF:PW.9"
                ],
                "precision": "low",
                "security-severity": "3.0"
              }
            },
            {
              "id": "LS-APP-007",
              "name": "SecurityHeadersMiddlewareDisabled",
              "shortDescription": {
                "text": "Security headers middleware disabled"
              },
              "fullDescription": {
                "text": "Helmet or an equivalent header middleware is commented out."
              },
              "help": {
                "text": "Enable security headers.\n\nFramework alignment:\n- OWASP-Web A05 Security Misconfiguration\n- CSA-CCM AIS-04 Secure Application Design and Development\n- CWE CWE-693 Protection Mechanism Failure\n- NIST-SSDF PW.9 Configure Software to Have Secure Settings by Default"
              },
