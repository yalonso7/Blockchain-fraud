              }
            },
            {
              "id": "LS-MAL-006",
              "name": "ProcessLaunchedDetachedOrHidden",
              "shortDescription": {
                "text": "Process launched detached or hidden"
              },
              "fullDescription": {
                "text": "A child process is started detached, hidden, or with nohup/start /b so it keeps running after the parent exits."
              },
              "help": {
                "text": "Confirm the background process is expected; loaders use this to persist past npm install.\n\nFramework alignment:\n- CSA-CCM TVM-02 Malware Protection Policy and Procedures\n- ATT&CK T1564.003 Hide Artifacts: Hidden Window\n- ATT&CK T1059 Command and Scripting Interpreter\n- CWE CWE-506 Embedded Malicious Code\n- NIST-SSDF PW.7 Review and/or Analyze Human-Readable Code to Identify Vulnerabilities"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "malware",
                  "CSA-CCM:TVM-02",
                  "ATT&CK:T1564.003",
                  "ATT&CK:T1059",
                  "CWE:CWE-506",
                  "NIST-SSDF:PW.7"
                ],
                "precision": "medium",
                "security-severity": "5.5"
              }
            },
            {
              "id": "LS-CON-006",
              "name": "XorDecodingLoop",
              "shortDescription": {
                "text": "XOR decoding loop"
              },
              "fullDescription": {
                "text": "A buffer is XORed against a repeating key, the usual way to unpack a hidden payload at runtime."
              },
              "help": {
                "text": "Check what the decoded data is used for; combined with eval or Function it is a loader.\n\nFramework alignment:\n- ATT&CK T1140 Deobfuscate/Decode Files or Information\n- ATT&CK T1027.013 Obfuscated Files or Information: Encrypted/Encoded File\n- CWE CWE-506 Embedded Malicious Code\n- NIST-SSDF PW.7 Review and/or Analyze Human-Readable Code to Identify Vulnerabilities"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
