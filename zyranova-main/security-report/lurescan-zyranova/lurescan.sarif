                  "NIST-SSDF:PO.5"
                ],
                "precision": "medium",
                "security-severity": "5.5"
              }
            },
            {
              "id": "LS-APP-004",
              "name": "SecretsWrittenToLogs",
              "shortDescription": {
                "text": "Secrets written to logs"
              },
              "fullDescription": {
                "text": "Tokens, passwords, keys, or seed phrases are logged."
              },
              "help": {
                "text": "Remove the log statement or redact the value.\n\nFramework alignment:\n- OWASP-Web A09 Security Logging and Monitoring Failures\n- CSA-CCM DSP-17 Sensitive Data Protection\n- CSA-CCM LOG-03 Security Monitoring and Alerting\n- CWE CWE-532 Insertion of Sensitive Information into Log File\n- NIST-SSDF PW.5 Create Source Code by Adhering to Secure Coding Practices"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
